{
  "name": "dsh-better-ears",
  "version": "0.2.0",
  "description": "Audio the agent can hear: speech transcription with timestamps, tempo/beat grid/downbeat, key & chords, song structure, loudness and cut-on-beat — local ffmpeg + DSP, no cloud required.",
  "type": "module",
  "main": "./index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "audio",
    "music",
    "speech",
    "transcription",
    "tempo",
    "chords",
    "ffmpeg"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "author": "Destinhue"
}
