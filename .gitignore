# 依赖（由 npm install 生成，不入库）
node_modules/
vendor/*/node_modules/

# 运行时产物：抓到的帧、冒烟输出、探针结果
.scratch/smoke/
.scratch/run/
.scratch/baseline/
.scratch/quality/
.scratch/probe/
.scratch/*/issues/**/attachments/

# 本地环境（venv 里有绝对路径，且体积巨大）
_deps/
*.pyc
__pycache__/

# 系统
Thumbs.db
.DS_Store

# 参考代码解压目录（本地看，不进仓库；原 zip 在 Downloads）
.scratch/ref/

# 打包产物（node scripts/pack.mjs 生成）
dist/

# 分发时用的临时目录（用户 2026-11-23 起把 -main/-env 拼在一起，再压 rar）
/dsh-watch-along-*/
*.rar
